{
  "manifest": {
    "publishingInformation": {
      "locales": {
        "es-ES": {
          "name": "Stremio",
          "summary": "Reproductor personal de Stremio adaptado a Echo Show.",
          "description": "Skill privada para navegar catálogos, buscar películas y series, elegir streams HTTPS de Stremio y reproducir vídeos con subtítulos SRT en dispositivos Echo Show.",
          "examplePhrases": [
            "Alexa, abre stremio",
            "Alexa, pide a stremio busca one piece",
            "Alexa, pide a stremio siguiente episodio"
          ],
          "keywords": [
            "stremio",
            "video",
            "echo show"
          ]
        }
      },
      "isAvailableWorldwide": false,
      "testingInstructions": "Skill de uso personal en modo desarrollo. Requiere dispositivo Echo Show con soporte APL 2024.2.",
      "category": "MOVIES_AND_TV",
      "distributionCountries": [
        "ES"
      ]
    },
    "apis": {
      "custom": {
        "endpoint": {
          "uri": "arn:aws:lambda:eu-west-1:000000000000:function:stremio-alexa-handler"
        },
        "interfaces": [
          {
            "type": "ALEXA_PRESENTATION_APL",
            "supportedViewports": [
              {
                "mode": "HUB",
                "shape": "ROUND",
                "minWidth": 100,
                "maxWidth": 599,
                "minHeight": 100,
                "maxHeight": 599
              },
              {
                "mode": "HUB",
                "shape": "RECTANGLE",
                "minWidth": 960,
                "maxWidth": 1279,
                "minHeight": 480,
                "maxHeight": 799
              },
              {
                "mode": "HUB",
                "shape": "RECTANGLE",
                "minWidth": 1280,
                "maxWidth": 1919,
                "minHeight": 800,
                "maxHeight": 1079
              },
              {
                "mode": "HUB",
                "shape": "RECTANGLE",
                "minWidth": 1920,
                "maxWidth": 2560,
                "minHeight": 1080,
                "maxHeight": 1440
              },
              {
                "mode": "TV",
                "shape": "RECTANGLE",
                "minWidth": 960,
                "maxWidth": 2560,
                "minHeight": 540,
                "maxHeight": 1440
              }
            ]
          }
        ]
      }
    },
    "manifestVersion": "1.0",
    "privacyAndData": {
      "allowsPurchases": false,
      "usesPersonalInfo": false,
      "isChildDirected": false,
      "isExportControlled": false,
      "containsAdvertising": false,
      "sharingScope": "PRIVATE"
    },
    "permissions": []
  }
}
